# Copy to config/application.yml (Figaro) or export these variables in your shell.
# Never commit real values. Generate SECRET_KEY_BASE with: bundle exec rake secret

SECRET_KEY_BASE=replace-with-output-of-rake-secret

DROPBOX_APP_KEY=your-dropbox-app-key
DROPBOX_APP_SECRET=your-dropbox-app-secret
DROPBOX_ACCESS_TOKEN=your-dropbox-access-token
DROPBOX_ACCESS_TOKEN_SECRET=your-dropbox-access-token-secret
DROPBOX_USER_ID=your-dropbox-user-id
